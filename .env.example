# Modo 'simulated' o 'real'.
IOTLINK_MASTER_MODE=simulated
IOTLINK_BIND_ADDRESS=127.0.0.1
IOTLINK_MASTER_PORT=1880

# En modo real, la URL debe ser accesible desde el worker.
IOTLINK_REAL_MASTER_URL=
IOTLINK_REAL_MASTER_TOKEN=

IOTLINK_POLL_INTERVAL_SECONDS=5
IOTLINK_HTTP_TIMEOUT_SECONDS=5
IOTLINK_RUN_ONCE=false
